<?xml version="1.0" encoding="UTF-8"?>
<definition:ConnectorDefinition
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:definition="http://www.bonitasoft.org/ns/connector/definition/6.1">

  <id>${workday-get-business-process.def.id}</id>
  <version>${workday-get-business-process.def.version}</version>
  <icon>workday.png</icon>
  <category icon="workday.png" id="Workday HCM"/>

  <input name="clientId" type="java.lang.String" mandatory="true"/>
  <input name="clientSecret" type="java.lang.String" mandatory="true"/>
  <input name="refreshToken" type="java.lang.String" mandatory="true"/>
  <input name="tenantAlias" type="java.lang.String" mandatory="true"/>
  <input name="basePath" type="java.lang.String" mandatory="false"/>
  <input name="tokenEndpoint" type="java.lang.String" mandatory="false"/>
  <input name="connectTimeout" type="java.lang.Integer" mandatory="false" defaultValue="30000"/>
  <input name="readTimeout" type="java.lang.Integer" mandatory="false" defaultValue="60000"/>
  <input name="processId" type="java.lang.String" mandatory="true"/>

  <output name="processStatus" type="java.lang.String"/>
  <output name="currentStep" type="java.lang.String"/>
  <output name="responseBody" type="java.lang.String"/>
  <output name="success" type="java.lang.Boolean"/>
  <output name="errorMessage" type="java.lang.String"/>

  <page id="connectionPage">
    <widget xsi:type="definition:Text" id="clientIdWidget" inputName="clientId"/>
    <widget xsi:type="definition:Password" id="clientSecretWidget" inputName="clientSecret"/>
    <widget xsi:type="definition:Password" id="refreshTokenWidget" inputName="refreshToken"/>
    <widget xsi:type="definition:Text" id="tenantAliasWidget" inputName="tenantAlias"/>
    <widget xsi:type="definition:Text" id="basePathWidget" inputName="basePath"/>
    <widget xsi:type="definition:Text" id="tokenEndpointWidget" inputName="tokenEndpoint"/>
    <widget xsi:type="definition:Text" id="connectTimeoutWidget" inputName="connectTimeout"/>
    <widget xsi:type="definition:Text" id="readTimeoutWidget" inputName="readTimeout"/>
  </page>
  <page id="operationPage">
    <widget xsi:type="definition:Text" id="processIdWidget" inputName="processId"/>
  </page>
</definition:ConnectorDefinition>
